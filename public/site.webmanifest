{
  "id": "./",
  "name": "Daymark Daily Planner",
  "short_name": "Daymark",
  "description": "A personal calendar and daily task planner.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#edf1e9",
  "theme_color": "#173b35",
  "icons": [
    {
      "src": "./daymark-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./daymark-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./daymark-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
